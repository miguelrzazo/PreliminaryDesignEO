{
  "latex-workshop.latex.recipe.default": "first",
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk (TFG)",
      "command": "/Library/TeX/texbin/latexmk",
      "args": [
        "-pdf",
        "-interaction=nonstopmode",
        "-halt-on-error",
        "%DOC%"
      ],
      "env": {
        "PATH": "/Library/TeX/texbin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin",
        "TFG_LATEX_BUILD_DIR": "/tmp/tfg-latex-build"
      },
      "cwd": "%DIR%"
    }
  ],
  "texpresso.command": "",
  "texpresso.previewLocation": "editor",
  "texpresso.externalCompileCommand": "/usr/bin/env PATH=/Library/TeX/texbin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin TFG_LATEX_BUILD_DIR=/tmp/tfg-latex-build /Library/TeX/texbin/latexmk -pdf -interaction=nonstopmode -halt-on-error",
  "texpresso.packageProvider": "texlive",
  "texpresso.autoRerun": true,
  "texpresso.useChangeRangeMode": true,
  "latex-workshop.latex.recipes": [
    {
      "name": "latexmk (TFG)",
      "tools": [
        "latexmk (TFG)"
      ]
    }
  ],
  "texpresso.syncTeXForwardOnSelection": true,
  "texpresso.includeDirectories": [
    "/tmp/tfg-latex-build"
  ]
}
